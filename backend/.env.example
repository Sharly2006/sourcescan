# Computer Vision Model Path
# Options:
# - yolov8s-world.pt (open-vocabulary detector, detects tyres, buckets, drums, plant pots)
# - yolo11n.pt (COCO detector, bottle, cup, potted plant)
# - Leave empty for transparent demo mode
MODEL_PATH=yolov8s-world.pt

# Toggle YOLO-World open-vocabulary container prompts
ENABLE_YOLO_WORLD=true

# Optional path to a water-presence classifier. Leave empty (default unavailable).
WATER_MODEL_PATH=

# Minimum confidence for detector predictions (0.0–1.0)
CONF_THRESHOLD=0.15

# Maximum upload size in megabytes
MAX_UPLOAD_MB=5

# Best-effort face blur (true/false). NOT a guarantee of privacy.
FACE_BLUR=false

# Comma-separated allowed CORS origins (includes Vite dev server port 5173 and 3000)
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000

# SQLite database file path
DB_PATH=sourcescan.db

# Opt-in demo data seeding (default false - never seeds fake data in production)
SEED_DEMO_DATA=false

# HTTP port for uvicorn
PORT=8000

